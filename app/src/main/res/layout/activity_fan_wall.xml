<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F3E5F5">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#6A1B9A">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎭 Namma Mela"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_centerVertical="true"
            android:layout_marginStart="16dp"/>

        <ImageView
            android:id="@+id/backBtn"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@android:drawable/ic_menu_revert"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="16dp"/>
    </RelativeLayout>

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✨ Fan Wall: Show Some Love! 👏"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_margin="12dp"
        android:textColor="#6A1B9A"/>

    <!-- Stage -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_marginHorizontal="12dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/stage_bg"
            android:scaleType="centerCrop"/>

        <TextView
            android:id="@+id/totalApplause"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👏 Total Applause: 0"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:padding="12dp"
            android:background="@drawable/applause_bg"
            android:layout_gravity="center"/>
    </FrameLayout>

    <!-- Recycler -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/commentRecycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"/>

    <!-- Input -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="#F3E5F5">

        <EditText
            android:id="@+id/commentInput"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:layout_weight="1"
            android:hint="Leave your applause..."
            android:textColor="#000000"
            android:textColorHint="#757575"
            android:textSize="16sp"
            android:background="@drawable/input_bg"
            android:padding="14dp"/>

        <Button
            android:id="@+id/sendBtn"
            android:layout_width="90dp"
            android:layout_height="55dp"
            android:text="POST"
            android:textStyle="bold"
            android:layout_marginStart="10dp"
            android:backgroundTint="#6A1B9A"
            android:textColor="#FFFFFF"/>
    </LinearLayout>

</LinearLayout>
