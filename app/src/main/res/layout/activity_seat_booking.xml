<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F4ECFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Full Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="#6A1B9A"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🎭 Namma Mela"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <ImageView
                android:id="@+id/backBtn"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@android:drawable/ic_menu_revert"
                android:tint="#FFFFFF"/>
        </LinearLayout>

        <!-- Content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Seat Booking"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#6A1B9A"
                android:gravity="center"
                android:layout_marginTop="8dp"/>

            <TextView
                android:id="@+id/tvSeatsLeft"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Seats Left: 25"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#4527A0"
                android:gravity="center"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="20dp"/>

            <!-- Seat Grid -->
            <GridLayout
                android:id="@+id/seatGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="5"
                android:rowCount="5"
                android:layout_marginBottom="20dp"/>

            <!-- Legend -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="#E53935"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" Booked   "
                    android:textSize="14sp"/>

                <TextView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="#00C853"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" Selected   "
                    android:textSize="14sp"/>

                <TextView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="#7E57C2"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" Available"
                    android:textSize="14sp"/>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Selected Seats"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"/>

            <TextView
                android:id="@+id/tvSelectedSeats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="None"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#311B92"
                android:gravity="center"
                android:layout_marginBottom="24dp"/>

            <!-- Confirm -->
            <Button
                android:id="@+id/btnConfirm"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Confirm Booking"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#8E24AA"
                android:layout_marginBottom="12dp"/>

            <!-- Cancel -->
            <Button
                android:id="@+id/btnCancel"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Cancel Booking"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#E53935"
                android:layout_marginBottom="12dp"/>

            <!-- Ticket -->
            <Button
                android:id="@+id/generateTicketBtn"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Generate Ticket"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#6A1B9A"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>